# Copy to .env and edit. Never commit .env.

# Root URL of the deployed app (no trailing slash).
APP_BASE_URL={{BASE_URL}}

# Optional: a user for the sign-in and role tests. Leave blank to skip them.
APP_USER=
APP_PASSWORD=

# Optional: a second user WITHOUT the app's privileged role, for the role-gate tests.
APP_USER_WITHOUT_ROLE=
APP_PASSWORD_WITHOUT_ROLE=

# Tests that create or change data only run when this is true.
# Leave false against any shared environment.
ALLOW_WRITES=false

# Named sample records. A check that needs a particular kind of record reads it from here
# (SAMPLE_<NAME>), never from "the first row". The README lists what each one must be.
{{SAMPLES}}
